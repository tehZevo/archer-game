{
  "name": "archer-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/esbuild.mjs src/main.ts dist/bundle.js --minify",
    "test": "node scripts/esbuild.mjs test/smoke.ts .tmp/smoke.cjs --node && node .tmp/smoke.cjs && vitest run",
    "watch": "node scripts/esbuild.mjs src/main.ts dist/bundle.js --watch",
    "dev": "npm run build:dev & python3 -m http.server 8000 --bind 0.0.0.0",
    "build:dev": "node scripts/esbuild.mjs src/main.ts dist/bundle.js --watch",
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "bake": "node scripts/esbuild.mjs scripts/bake.ts .tmp/bake.cjs --node && node .tmp/bake.cjs",
    "fxpreview": "node scripts/esbuild.mjs scripts/fxpreview.ts .tmp/fxpreview.cjs --node && node .tmp/fxpreview.cjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "trystero": "^0.27.0"
  }
}
