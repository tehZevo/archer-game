{
  "name": "archer-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --minify --loader:.png=dataurl",
    "test": "esbuild test/smoke.ts --bundle --outfile=.tmp/smoke.cjs --platform=node --target=node18 --loader:.png=dataurl && node .tmp/smoke.cjs && vitest run",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --loader:.png=dataurl --watch=forever",
    "dev": "npm run build:dev & python3 -m http.server 8000 --bind 0.0.0.0",
    "build:dev": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --format=iife --target=es2020 --loader:.png=dataurl --watch=forever",
    "start": "python3 -m http.server 8000 --bind 0.0.0.0",
    "bake": "esbuild scripts/bake.ts --bundle --outfile=.tmp/bake.cjs --platform=node --target=node18 --loader:.png=dataurl --log-level=warning && node .tmp/bake.cjs",
    "fxpreview": "esbuild scripts/fxpreview.ts --bundle --outfile=.tmp/fxpreview.cjs --platform=node --target=node18 --loader:.png=dataurl --log-level=warning && node .tmp/fxpreview.cjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "trystero": "^0.27.0"
  }
}
